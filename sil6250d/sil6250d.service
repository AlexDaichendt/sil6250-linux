[Unit]
Description=Silead SIL6250 fingerprint daemon (open-fprintd backend)
After=dbus.socket
# Register with open-fprintd whenever it appears; the daemon watches for the
# manager name on the bus and re-registers automatically, so order here is soft.
Wants=open-fprintd.service
After=open-fprintd.service

[Service]
Type=dbus
BusName=io.github.uunicorn.Fprint
ExecStart=/usr/local/bin/sil6250d
Environment=SIL6250_DEV=/dev/sil6250
User=root
Group=root
UMask=0077
StateDirectory=open-fprintd/sil6250
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/sil6250 rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
